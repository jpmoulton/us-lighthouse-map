# This workspace also holds private site administration and research archives.
# Only the public map source and release files below belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/serve.js
!/build-website.js
!/build-usa-map.js
!/export-wordpress.py
!/website-document-template.html
!/website-map-template.html
!/usa-map-template.html
!/usa-map.js
!/map-geometry.js
!/lighthouse-info.js
!/assets/
/assets/*
!/assets/map-preview.png
!/data/
/data/*
!/data/d3.min.js
!/data/D3-LICENSE.txt
!/data/us-lighthouses.json
!/data/us-states.json
!/data/us-lakes.json
!/data/ui/
/data/ui/*
!/data/ui/geist-latin.woff2
!/data/ui/OFL-Geist.txt
!/data/ui/FONT-SOURCE.md
!/data/info/
/data/info/*
!/data/info/base-corrections.json
!/data/info/profiles.json
!/data/info/light-appearance.json
!/data/info/light-appearance-review.json
!/data/info/audit-progress.json
!/data/info/audit-release.json
!/data/info/summaries.json
!/data/info/summary-release.json
!/wordpress/
/wordpress/*
!/wordpress/jmoul-map-tracking.js
!/deploy/
/deploy/*
!/deploy/lighthouse-map/
/deploy/lighthouse-map/*
!/deploy/lighthouse-map/index.html
!/deploy/lighthouse-map/D3-LICENSE.txt
!/deploy/lighthouse-map/OFL-Geist.txt
!/deploy/lighthouse-map/THIRD_PARTY_NOTICES.md
